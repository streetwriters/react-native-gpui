# Dependency / build artifacts
node_modules/
# Also match a symlink: `node_modules/` only matches a directory, and a worktree
# that symlinks its dependencies into place would otherwise have the link itself
# committed, pointing at an absolute path on one machine.
node_modules
target/
build/
*.o
*.a
*.so
*.dylib
*.framework

# Editors / OS
.DS_Store
*.iml
.idea/
.vscode/

# Gradle (Android tooling present in node_modules)
.gradle/
local.properties
.local/
packages/hermes/bin/
desktop/build/
desktop/.cache/

# Root-level autolink output from local package tests
/desktop/

# Compiled testing client (included in npm packs)
/packages/testing/dist/

# CI step logs, reports and packed tarballs
/ci-out/

# ccache directory, pinned by CI so one cache path works on every OS
/.ccache/

# Cargo ignores a dependency crate's lockfile, so a tracked one only goes stale.
modules/*/desktop/Cargo.lock
