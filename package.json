{
  "name": "react-native-gpui",
  "private": true,
  "version": "0.0.1",
  "description": "React Native on GPUI — a desktop platform for React Native using the GPUI rendering framework (macOS, Windows, Linux).",
  "workspaces": [
    "packages/react-native-gpui",
    "packages/@rn-gpui/cli",
    "packages/@rn-gpui/codegen",
    "template",
    "tester"
  ],
  "scripts": {
    "test:retention": "bash tester/scripts/verify-retention.sh",
    "bench:10k": "bash tester/scripts/run-10k-benchmark.sh",
    "probe:textinput": "bash tester/scripts/run-textinput-probe.sh",
    "probe:transform": "bash tester/scripts/run-transform-probe.sh",
    "probe:native-animated": "bash tester/scripts/run-native-animated-probe.sh",
    "probe:core-modules": "bash tester/scripts/run-core-modules-probe.sh",
    "probe:dimensions": "bash tester/scripts/run-dimensions-probe.sh",
    "probe:accessibility": "RN_GPUI_PHASE3_PROBE=AccessibilityProbe bash tester/scripts/run-phase3-probe.sh",
    "probe:appearance": "RN_GPUI_PHASE3_PROBE=AppearanceProbe bash tester/scripts/run-phase3-probe.sh",
    "probe:borders": "RN_GPUI_PHASE3_PROBE=BorderProbe bash tester/scripts/run-phase3-probe.sh",
    "probe:modal": "RN_GPUI_PHASE3_PROBE=ModalProbe bash tester/scripts/run-phase3-probe.sh",
    "probe:phase3-acceptance": "RN_GPUI_PHASE3_PROBE=Phase3AcceptanceProbe bash tester/scripts/run-phase3-probe.sh",
    "probe:phase4-composition": "bash tester/scripts/run-phase4-composition-probe.sh",
    "probe:phase4-webview": "bash tester/scripts/run-phase4-webview-probe.sh"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "^0.87.1",
    "react-native-platform-override": "^0.84.0"
  }
}
