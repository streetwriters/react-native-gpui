    "autolink": "react-native-gpui autolink"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "^0.87.1",
    "react-native-platform-override": "^0.84.0",
    "@react-native-gpui/native-module-fixture": "0.1.0",
    "@react-native-gpui/cli": "0.1.0"
  }
}
