{
  "name": "react-native-gpui",
  "private": true,
  "version": "0.0.1",
  "description": "React Native on GPUI — a desktop platform for React Native using the GPUI rendering framework (macOS, Windows, Linux).",
  "workspaces": [
    "packages/react-native-gpui",
    "packages/@react-native-gpui/cli",
    "packages/@react-native-gpui/codegen",
    "tester",
    "tester/gpui-native-module",
