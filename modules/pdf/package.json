{
  "name": "@react-native-gpui/pdf",
  "version": "0.0.1-alpha.0",
  "description": "EmbedPDF's PDF engine for React Native GPUI apps, running on its own native PDFium runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetwriters/react-native-gpui.git",
    "directory": "modules/pdf"
  },
  "homepage": "https://streetwriters.github.io/react-native-gpui/",
  "bugs": {
    "url": "https://github.com/streetwriters/react-native-gpui/issues"
  },
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "src",
    "desktop",
    "react-native.config.js",
    "metro.cjs",
    "metro-babel-transformer.cjs",
    "scripts",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@embedpdf/engine": "3.1.0",
    "@embedpdf/engine-core": "3.1.0",
    "@embedpdf/engine-services": "3.1.0",
    "@embedpdf/default-fallback-fonts": "1.0.0",
    "@embedpdf/core": "3.1.0",
    "@embedpdf/plugin-render": "3.1.0",
    "@embedpdf/plugin-search": "3.1.0",
    "@embedpdf/plugin-selection": "3.1.0",
    "@embedpdf/plugin-interaction": "3.1.0"
  },
  "optionalDependencies": {
    "@embedpdf/engine-runtime-darwin-arm64": "3.1.0",
    "@embedpdf/engine-runtime-darwin-x64": "3.1.0",
    "@embedpdf/engine-runtime-linux-arm64": "3.1.0",
    "@embedpdf/engine-runtime-linux-x64": "3.1.0",
    "@embedpdf/engine-runtime-win32-arm64": "3.1.0",
    "@embedpdf/engine-runtime-win32-x64": "3.1.0"
  },
  "peerDependencies": {
    "react-native": "0.87.x"
  },
  "scripts": {
    "prepack": "node scripts/generate-notices.mjs"
  },
  "codegenConfig": {
    "name": "RNGpuiPdfSpec",
    "type": "all",
    "jsSrcsDir": "src"
  }
}
