{
  "name": "@react-native-gpui/codegen",
  "version": "0.87.0-alpha.0",
  "description": "C++ and Rust code generators for react-native-gpui, plugged into @react-native/codegen.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetwriters/react-native-gpui.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://streetwriters.github.io/react-native-gpui/",
  "bugs": {
    "url": "https://github.com/streetwriters/react-native-gpui/issues"
  },
  "files": [
    "src",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/*.test.ts",
    "!**/*.test.cjs"
  ],
  "type": "module",
  "exports": {
    "./generate-cxx-spec": "./src/generate-cxx-spec.js",
    "./generate-rust-spec": "./src/generate-rust-spec.js",
    "./generate-host-component-cpp": "./src/generate-host-component-cpp.js"
  },
  "scripts": {
    "generate-cxx-spec": "node ./src/generate-cxx-spec.js",
    "generate-rust-spec": "node ./src/generate-rust-spec.js"
  },
  "dependencies": {
    "@react-native/codegen": "0.87.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
