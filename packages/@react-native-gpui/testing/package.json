{
  "name": "@react-native-gpui/testing",
  "version": "0.1.0",
  "description": "Test presets and desktop test-driver client for React Native GPUI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jest-preset": "./jest-preset.js",
    "./vitest-preset": "./vitest-preset.cjs",
    "./jest-preset-e2e": "./jest-preset-e2e.cjs",
    "./jest-environment": "./jest-environment.cjs",
    "./jest-preset-e2e/jest-preset": "./e2e/jest-preset.js",
    "./vitest-e2e": {
      "types": "./dist/vitest-e2e.d.mts",
      "default": "./dist/vitest-e2e.mjs"
    }
  },
  "peerDependencies": {
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": ">=13",
    "jest": ">=29",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@react-native/jest-preset": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "typescript": "6.0.3",
    "@types/node": "^22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "jest",
    "e2e",
    "*.js",
    "*.cjs"
  ]
}
