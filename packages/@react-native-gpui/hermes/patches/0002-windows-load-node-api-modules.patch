+#undef unorm2_getNFCInstance
+#define unorm2_getNFCInstance \
+  (::hermes::platform_unicode::icuFunctions()->unorm2_getNFCInstance)
+#undef unorm2_getNFDInstance
+#define unorm2_getNFDInstance \
+  (::hermes::platform_unicode::icuFunctions()->unorm2_getNFDInstance)
+#undef unorm2_getNFKCInstance
+#define unorm2_getNFKCInstance \
