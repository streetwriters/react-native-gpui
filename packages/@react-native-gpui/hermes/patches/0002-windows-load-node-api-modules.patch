+#define ucol_strcoll (::hermes::platform_unicode::icuFunctions()->ucol_strcoll)
+#undef udat_open
+#define udat_open (::hermes::platform_unicode::icuFunctions()->udat_open)
+#undef udat_close
+#define udat_close (::hermes::platform_unicode::icuFunctions()->udat_close)
+#undef udat_format
+#define udat_format (::hermes::platform_unicode::icuFunctions()->udat_format)
