+  if (!platform_unicode::icuFunctions()) {
+    std::u16string out = str;
+    for (char16_t &c : out) {
+      if (upper && c >= u'a' && c <= u'z')
+        c = c - u'a' + u'A';
+      else if (!upper && c >= u'A' && c <= u'Z')
+        c = c - u'A' + u'a';
+    }
+    return out;
+  }
