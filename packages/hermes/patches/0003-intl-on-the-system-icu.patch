+const char16_t *icuUnit(std::u16string_view ecma) {
+  for (const UnitName &unit : kUnits) {
+    if (ecma == unit.ecma) {
+      return unit.icu;
+    }
+  }
+  return nullptr;
+}
+
+/// Splits "a-per-b" into its parts. Unit names themselves contain "-" but
+/// none contains "-per-".
+bool splitUnit(
+    std::u16string_view unit,
+    std::u16string_view &numerator,
+    std::u16string_view &denominator) {
+  size_t per = unit.find(u"-per-");
+  if (per == std::u16string_view::npos) {
+    numerator = unit;
+    denominator = {};
+    return icuUnit(unit) != nullptr;
+  }
+  numerator = unit.substr(0, per);
+  denominator = unit.substr(per + 5);
+  return icuUnit(numerator) != nullptr && icuUnit(denominator) != nullptr;
+}
+
+/// https://402.ecma-international.org/8.0/#sec-iswellformedcurrencycode
+bool isWellFormedCurrencyCode(std::u16string_view currency) {
+  if (currency.size() != 3) {
+    return false;
+  }
+  return std::all_of(currency.begin(), currency.end(), [](char16_t c) {
+    return (c >= u'A' && c <= u'Z') || (c >= u'a' && c <= u'z');
+  });
+}
+
+const char *roundingModeToken(std::u16string_view mode) {
+  if (mode == u"ceil")
+    return "rounding-mode-ceiling";
+  if (mode == u"floor")
+    return "rounding-mode-floor";
+  if (mode == u"expand")
+    return "rounding-mode-up";
+  if (mode == u"trunc")
+    return "rounding-mode-down";
+  if (mode == u"halfCeil")
+    return "rounding-mode-half-ceiling";
+  if (mode == u"halfFloor")
+    return "rounding-mode-half-floor";
+  if (mode == u"halfTrunc")
+    return "rounding-mode-half-down";
+  if (mode == u"halfEven")
+    return "rounding-mode-half-even";
+  // halfExpand, ECMA-402's default: ties go away from zero.
+  return "rounding-mode-half-up";
+}
+
+void append(std::u16string &out, const char *ascii) {
+  for (; *ascii; ++ascii) {
+    out.push_back(static_cast<char16_t>(*ascii));
+  }
+}
