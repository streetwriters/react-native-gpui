+  std::string icuLocale = requested->empty()
+      ? std::string(uloc_getDefault())
+      : impl_icu::convertBCP47toICULocale(
+            requested->front().getLocaleNoExt());
+  UErrorCode status = U_ZERO_ERROR;
+  std::u16string out(str.size() + 4, u'\0');
+  auto convert = upper ? u_strToUpper : u_strToLower;
+  int32_t length = convert(
+      reinterpret_cast<UChar *>(&out[0]),
+      static_cast<int32_t>(out.size()),
+      reinterpret_cast<const UChar *>(str.data()),
+      static_cast<int32_t>(str.size()),
+      icuLocale.c_str(),
+      &status);
+  if (status == U_BUFFER_OVERFLOW_ERROR) {
+    status = U_ZERO_ERROR;
+    out.assign(length, u'\0');
+    convert(
+        reinterpret_cast<UChar *>(&out[0]),
+        length,
+        reinterpret_cast<const UChar *>(str.data()),
+        static_cast<int32_t>(str.size()),
+        icuLocale.c_str(),
+        &status);
+  }
+  if (U_FAILURE(status)) {
+    return str;
+  }
+  out.resize(length);
+  return out;
