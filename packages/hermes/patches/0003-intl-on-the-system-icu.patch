+/// A sanctioned simple unit of ECMA-402 and the CLDR unit ICU names it by.
+struct UnitName {
+  const char16_t *ecma;
+  const char16_t *icu;
+};
+
+/// https://402.ecma-international.org/8.0/#table-sanctioned-single-unit-identifiers
+constexpr UnitName kUnits[] = {
+    {u"acre", u"area-acre"},
+    {u"bit", u"digital-bit"},
