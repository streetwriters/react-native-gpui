+  if (!*unitRes) {
+    if (style_ == u"unit")
+      return runtime.raiseTypeError("Unit is undefined");
+  } else {
+    std::u16string_view numerator, denominator;
+    if (!splitUnit(**unitRes, numerator, denominator))
+      return runtime.raiseRangeError("Unit is invalid");
+  }
+
+  auto unitDisplayRes = getStringOption(
+      runtime,
+      options,
+      u"unitDisplay",
+      {u"short", u"narrow", u"long"},
+      u"short");
+  if (LLVM_UNLIKELY(unitDisplayRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+
+  if (style_ == u"currency") {
+    currency_ = toASCIIUppercase(**currencyRes);
+    currencyDisplay_ = **currencyDisplayRes;
+    currencySign_ = **currencySignRes;
+  }
+  if (style_ == u"unit") {
+    unit_ = **unitRes;
+    unitDisplay_ = **unitDisplayRes;
+  }
+  return vm::ExecutionStatus::RETURNED;
+}
+
+vm::ExecutionStatus NumberFormat::setDigitOptions(
+    vm::Runtime &runtime,
+    const Options &options,
+    int mnfdDefault,
+    int mxfdDefault) noexcept {
+  // https://402.ecma-international.org/8.0/#sec-setnfdigitoptions
+  auto mnidRes =
+      getNumberOption(runtime, options, u"minimumIntegerDigits", 1, 21, 1);
+  if (LLVM_UNLIKELY(mnidRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  minimumIntegerDigits_ = static_cast<int>(**mnidRes);
+
+  const bool hasMnfd = options.count(u"minimumFractionDigits") > 0;
+  const bool hasMxfd = options.count(u"maximumFractionDigits") > 0;
+  const bool hasMnsd = options.count(u"minimumSignificantDigits") > 0;
+  const bool hasMxsd = options.count(u"maximumSignificantDigits") > 0;
+
+  if (hasMnsd || hasMxsd) {
+    roundingType_ = u"significantDigits";
+    auto mnsdRes =
+        getNumberOption(runtime, options, u"minimumSignificantDigits", 1, 21, 1);
+    if (LLVM_UNLIKELY(mnsdRes == vm::ExecutionStatus::EXCEPTION))
+      return vm::ExecutionStatus::EXCEPTION;
+    const int mnsd = static_cast<int>(**mnsdRes);
+    auto mxsdRes = getNumberOption(
+        runtime, options, u"maximumSignificantDigits", mnsd, 21, 21);
+    if (LLVM_UNLIKELY(mxsdRes == vm::ExecutionStatus::EXCEPTION))
+      return vm::ExecutionStatus::EXCEPTION;
+    significantDigits_ = std::make_pair(mnsd, static_cast<int>(**mxsdRes));
+  } else if (hasMnfd || hasMxfd) {
+    roundingType_ = u"fractionDigits";
+    auto mnfdRes =
+        getNumberOption(runtime, options, u"minimumFractionDigits", 0, 20, {});
+    if (LLVM_UNLIKELY(mnfdRes == vm::ExecutionStatus::EXCEPTION))
+      return vm::ExecutionStatus::EXCEPTION;
+    auto mxfdRes =
+        getNumberOption(runtime, options, u"maximumFractionDigits", 0, 20, {});
+    if (LLVM_UNLIKELY(mxfdRes == vm::ExecutionStatus::EXCEPTION))
+      return vm::ExecutionStatus::EXCEPTION;
+    int mnfd, mxfd;
+    if (!*mnfdRes) {
+      mxfd = static_cast<int>(**mxfdRes);
+      mnfd = std::min(mnfdDefault, mxfd);
+    } else if (!*mxfdRes) {
+      mnfd = static_cast<int>(**mnfdRes);
+      mxfd = std::max(mxfdDefault, mnfd);
+    } else {
+      mnfd = static_cast<int>(**mnfdRes);
+      mxfd = static_cast<int>(**mxfdRes);
+      if (mnfd > mxfd) {
+        return runtime.raiseRangeError(
+            "minimumFractionDigits is greater than maximumFractionDigits");
+      }
+    }
+    fractionDigits_ = std::make_pair(mnfd, mxfd);
+  } else if (notation_ == u"compact") {
+    roundingType_ = u"compactRounding";
+  } else {
+    roundingType_ = u"fractionDigits";
+    fractionDigits_ = std::make_pair(mnfdDefault, mxfdDefault);
+  }
+  return vm::ExecutionStatus::RETURNED;
+}
+
+vm::ExecutionStatus NumberFormat::initialize(
+    vm::Runtime &runtime,
+    const std::vector<std::u16string> &locales,
+    const Options &options) noexcept {
+  if (!platform_unicode::icuFunctions()) {
+    // No ICU: numbers print as JavaScript's own number-to-string would.
+    locale_ = u"en-US";
+    style_ = u"decimal";
+    notation_ = u"standard";
+    signDisplay_ = u"auto";
+    useGrouping_ = u"false";
+    return vm::ExecutionStatus::RETURNED;
+  }
+  // 1. Let requestedLocales be ? CanonicalizeLocaleList(locales).
+  auto requestedLocalesRes =
+      LocaleBCP47Object::canonicalizeLocaleList(runtime, locales);
+  if (LLVM_UNLIKELY(requestedLocalesRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+
+  // 4. Let matcher be ? GetOption(options, "localeMatcher", ...).
+  Options opt;
+  auto matcherRes = getStringOption(
+      runtime,
+      options,
+      u"localeMatcher",
+      {u"lookup", u"best fit"},
+      u"best fit");
+  if (LLVM_UNLIKELY(matcherRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  opt.emplace(u"localeMatcher", **matcherRes);
+
+  // 6. Let numberingSystem be ? GetOption(options, "numberingSystem", ...).
+  auto numberingSystemRes =
+      getStringOption(runtime, options, u"numberingSystem", {}, {});
+  if (LLVM_UNLIKELY(numberingSystemRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  if (*numberingSystemRes) {
+    if (!isUnicodeExtensionType(**numberingSystemRes)) {
+      return runtime.raiseRangeError(
+          vm::TwineChar16("Invalid numbering system: ") +
+          vm::TwineChar16((*numberingSystemRes)->c_str()));
+    }
+    opt.emplace(u"nu", **numberingSystemRes);
+  }
+
+  // 10. Let r be ResolveLocale(...).
+  static constexpr std::u16string_view relevantExtensionKeys[] = {u"nu"};
+  auto r = resolveLocale(
+      *requestedLocalesRes,
+      opt,
+      relevantExtensionKeys,
+      [](auto key, auto type, auto locale) { return true; });
+  locale_ = r.localeBcp47Object.getCanonicalizedLocaleId();
+  locale8_ = toUTF8ASCII(locale_);
+  auto nuIt = r.resolvedOpts.find(u"nu");
+  if (nuIt != r.resolvedOpts.end()) {
+    numberingSystem_ = nuIt->second.getString();
+  }
+
+  // 14. Perform ? SetNumberFormatUnitOptions(numberFormat, options).
+  if (LLVM_UNLIKELY(
+          setUnitOptions(runtime, options) == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+
+  int mnfdDefault = 0;
+  int mxfdDefault = 3;
+  if (style_ == u"currency") {
+    // CurrencyDigits(currency): ISO 4217's minor unit.
+    UErrorCode status = U_ZERO_ERROR;
+    int32_t digits = ucurr_getDefaultFractionDigits(
+        reinterpret_cast<const UChar *>(currency_->c_str()), &status);
+    if (U_FAILURE(status)) {
+      digits = 2;
+    }
+    mnfdDefault = mxfdDefault = digits;
+  } else if (style_ == u"percent") {
+    mxfdDefault = 0;
+  }
+
+  auto notationRes = getStringOption(
+      runtime,
+      options,
+      u"notation",
+      {u"standard", u"scientific", u"engineering", u"compact"},
+      u"standard");
+  if (LLVM_UNLIKELY(notationRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  notation_ = **notationRes;
+
+  if (LLVM_UNLIKELY(
+          setDigitOptions(runtime, options, mnfdDefault, mxfdDefault) ==
+          vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+
+  auto compactDisplayRes = getStringOption(
+      runtime, options, u"compactDisplay", {u"short", u"long"}, u"short");
+  if (LLVM_UNLIKELY(compactDisplayRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  if (notation_ == u"compact") {
+    compactDisplay_ = **compactDisplayRes;
+  }
+
+  // useGrouping: false turns it off; compact notation groups from 5 digits
+  // (min2); otherwise ICU's locale default.
+  auto useGrouping = getBoolOption(options, u"useGrouping", true);
+  useGrouping_ = !*useGrouping ? u"false"
+      : notation_ == u"compact" ? u"min2"
+                                : u"auto";
+
+  auto signDisplayRes = getStringOption(
+      runtime,
+      options,
+      u"signDisplay",
+      {u"auto", u"never", u"always", u"exceptZero", u"negative"},
+      u"auto");
+  if (LLVM_UNLIKELY(signDisplayRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  signDisplay_ = **signDisplayRes;
+
+  auto roundingModeRes = getStringOption(
+      runtime,
+      options,
+      u"roundingMode",
+      {u"ceil",
+       u"floor",
+       u"expand",
+       u"trunc",
+       u"halfCeil",
+       u"halfFloor",
+       u"halfExpand",
+       u"halfTrunc",
+       u"halfEven"},
+      u"halfExpand");
+  if (LLVM_UNLIKELY(roundingModeRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  roundingMode_ = **roundingModeRes;
+
+  auto trailingZeroRes = getStringOption(
+      runtime,
+      options,
+      u"trailingZeroDisplay",
+      {u"auto", u"stripIfInteger"},
+      u"auto");
+  if (LLVM_UNLIKELY(trailingZeroRes == vm::ExecutionStatus::EXCEPTION))
+    return vm::ExecutionStatus::EXCEPTION;
+  trailingZeroDisplay_ = **trailingZeroRes;
+
+  // Units are named "unit/kilometer-per-hour" from ICU 67; before that only
+  // the "measure-unit/length-kilometer per-measure-unit/duration-hour" form
+  // exists, and newer ICU drops some of its names. So try the modern form
+  // first and fall back to the old one.
+  UErrorCode status = U_ZERO_ERROR;
+  for (bool legacyUnits : {false, true}) {
+    if (legacyUnits && style_ != u"unit") {
+      break;
+    }
+    const std::u16string skeletonText = skeleton(legacyUnits);
+    status = U_ZERO_ERROR;
+    formatter_ = unumf_openForSkeletonAndLocale(
+        reinterpret_cast<const UChar *>(skeletonText.c_str()),
+        static_cast<int32_t>(skeletonText.size()),
+        locale8_.c_str(),
+        &status);
+    if (U_SUCCESS(status) && formatter_) {
+      break;
+    }
+    formatter_ = nullptr;
+  }
+  if (!formatter_) {
+    return runtime.raiseRangeError("Unsupported number format options");
+  }
+  return vm::ExecutionStatus::RETURNED;
+}
+
+std::u16string NumberFormat::skeleton(bool legacyUnits) const {
+  std::u16string s;
+  auto token = [&s](const std::u16string &text) {
+    if (!s.empty()) {
+      s.push_back(u' ');
+    }
+    s += text;
+  };
+  auto tokenAscii = [&s](const char *text) {
+    if (!s.empty()) {
+      s.push_back(u' ');
+    }
+    append(s, text);
+  };
+
+  if (style_ == u"percent") {
+    tokenAscii("percent scale/100");
+  } else if (style_ == u"currency") {
+    token(u"currency/" + *currency_);
+    if (*currencyDisplay_ == u"code")
+      tokenAscii("unit-width-iso-code");
+    else if (*currencyDisplay_ == u"narrowSymbol")
+      tokenAscii("unit-width-narrow");
+    else if (*currencyDisplay_ == u"name")
+      tokenAscii("unit-width-full-name");
+  } else if (style_ == u"unit") {
+    if (legacyUnits) {
+      std::u16string_view numerator, denominator;
+      splitUnit(*unit_, numerator, denominator);
+      token(u"measure-unit/" + std::u16string(icuUnit(numerator)));
+      if (!denominator.empty()) {
+        token(u"per-measure-unit/" + std::u16string(icuUnit(denominator)));
+      }
+    } else {
+      token(u"unit/" + *unit_);
+    }
+    if (*unitDisplay_ == u"narrow")
+      tokenAscii("unit-width-narrow");
+    else if (*unitDisplay_ == u"long")
+      tokenAscii("unit-width-full-name");
+    else
+      tokenAscii("unit-width-short");
+  }
+
+  if (notation_ == u"scientific")
+    tokenAscii("scientific");
+  else if (notation_ == u"engineering")
+    tokenAscii("engineering");
+  else if (notation_ == u"compact")
+    tokenAscii(*compactDisplay_ == u"long" ? "compact-long" : "compact-short");
+
+  if (roundingType_ == u"significantDigits") {
+    std::u16string precision(significantDigits_->first, u'@');
+    precision.append(
+        significantDigits_->second - significantDigits_->first, u'#');
+    if (trailingZeroDisplay_ == u"stripIfInteger")
+      precision += u"/w";
+    token(precision);
+  } else if (roundingType_ == u"fractionDigits") {
+    const int mn = fractionDigits_->first;
+    const int mx = fractionDigits_->second;
+    if (mx == 0) {
+      tokenAscii("precision-integer");
+    } else {
+      std::u16string precision = u".";
+      precision.append(mn, u'0');
+      precision.append(mx - mn, u'#');
+      if (trailingZeroDisplay_ == u"stripIfInteger")
+        precision += u"/w";
+      token(precision);
+    }
+  }
+
+  tokenAscii(roundingModeToken(roundingMode_));
+
+  if (minimumIntegerDigits_ > 1) {
+    token(u"integer-width/*" + std::u16string(minimumIntegerDigits_, u'0'));
+  }
+
+  if (useGrouping_ == u"false")
+    tokenAscii("group-off");
+  else if (useGrouping_ == u"min2")
+    tokenAscii("group-min2");
+
+  const bool accounting = style_ == u"currency" && currencySign_ &&
+      *currencySign_ == u"accounting";
+  if (signDisplay_ == u"never") {
+    tokenAscii("sign-never");
+  } else if (signDisplay_ == u"always") {
+    tokenAscii(accounting ? "sign-accounting-always" : "sign-always");
+  } else if (signDisplay_ == u"exceptZero") {
+    tokenAscii(
+        accounting ? "sign-accounting-except-zero" : "sign-except-zero");
+  } else if (signDisplay_ == u"negative") {
+    tokenAscii(accounting ? "sign-accounting-negative" : "sign-negative");
+  } else if (accounting) {
+    tokenAscii("sign-accounting");
+  }
+
+  return s;
+}
+
+std::u16string NumberFormat::formatInto(
+    double number,
+    UFormattedNumber *result) noexcept {
+  UErrorCode status = U_ZERO_ERROR;
+  // A NaN carries a sign bit that ICU would print as "-NaN".
+  if (std::isnan(number)) {
+    number = std::numeric_limits<double>::quiet_NaN();
+  }
+  unumf_formatDouble(formatter_, number, result, &status);
+  std::u16string text;
+  if (U_FAILURE(status)) {
+    return text;
+  }
+  int32_t length = unumf_resultToString(result, nullptr, 0, &status);
+  if (status == U_BUFFER_OVERFLOW_ERROR) {
+    status = U_ZERO_ERROR;
+    text.resize(length);
+    unumf_resultToString(
+        result, reinterpret_cast<UChar *>(&text[0]), length, &status);
+  }
+  return U_FAILURE(status) ? std::u16string() : text;
+}
+
+std::u16string NumberFormat::format(double number) noexcept {
+  if (!formatter_) {
+    return plainNumber(number);
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  std::unique_ptr<UFormattedNumber, FormatterDeleter> result(
+      unumf_openResult(&status));
+  if (U_FAILURE(status)) {
+    return std::u16string();
+  }
+  return formatInto(number, result.get());
+}
+
+std::vector<Part> NumberFormat::formatToParts(double number) noexcept {
+  if (!formatter_) {
+    Part part;
+    part[u"type"] = std::isnan(number) ? u"nan" : u"integer";
+    part[u"value"] = plainNumber(number);
+    return {part};
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  std::unique_ptr<UFormattedNumber, FormatterDeleter> result(
+      unumf_openResult(&status));
+  if (U_FAILURE(status)) {
+    return {};
+  }
+  const std::u16string text = formatInto(number, result.get());
+  if (text.empty()) {
+    return {};
+  }
+
+  // Each character belongs to the narrowest field that contains it: the
+  // grouping separators lie inside the integer field, for example.
+  std::vector<int32_t> fieldOf(text.size(), -1);
+  std::vector<int32_t> spanOf(text.size(), INT32_MAX);
+  UFieldPositionIterator *positions = ufieldpositer_open(&status);
+  if (U_SUCCESS(status)) {
+    unumf_resultGetAllFieldPositions(result.get(), positions, &status);
+    if (U_SUCCESS(status)) {
+      int32_t begin = 0, end = 0;
+      for (;;) {
+        int32_t field = ufieldpositer_next(positions, &begin, &end);
+        if (field < 0) {
+          break;
+        }
+        for (int32_t i = begin; i < end && i < (int32_t)text.size(); ++i) {
+          if (end - begin < spanOf[i]) {
+            spanOf[i] = end - begin;
+            fieldOf[i] = field;
+          }
+        }
+      }
+    }
+    ufieldpositer_close(positions);
+  }
+
+  const bool negative = text.find(u'-') != std::u16string::npos ||
+      text.find(u'−') != std::u16string::npos || std::signbit(number);
+  const bool notANumber = std::isnan(number);
+  const bool infinite = std::isinf(number);
+
+  std::vector<Part> parts;
+  size_t start = 0;
+  while (start < text.size()) {
+    size_t end = start + 1;
+    while (end < text.size() && fieldOf[end] == fieldOf[start]) {
+      ++end;
+    }
+    const char16_t *type = fieldOf[start] < 0
+        ? nullptr
+        : partType(fieldOf[start], negative);
+    if (type && std::u16string_view(type) == u"integer") {
+      if (notANumber)
+        type = u"nan";
+      else if (infinite)
+        type = u"infinity";
+    }
+    Part part;
+    part[u"type"] = type ? type : u"literal";
+    part[u"value"] = text.substr(start, end - start);
+    parts.push_back(std::move(part));
+    start = end;
+  }
+  return parts;
+}
+
+Options NumberFormat::resolvedOptions() noexcept {
+  Options options;
+  options.emplace(u"locale", locale_);
+  options.emplace(u"numberingSystem", numberingSystem_.value_or(u"latn"));
+  options.emplace(u"style", style_);
+  if (currency_) {
+    options.emplace(u"currency", *currency_);
+    options.emplace(u"currencyDisplay", *currencyDisplay_);
+    options.emplace(u"currencySign", *currencySign_);
+  }
+  if (unit_) {
+    options.emplace(u"unit", *unit_);
+    options.emplace(u"unitDisplay", *unitDisplay_);
+  }
+  options.emplace(
+      u"minimumIntegerDigits", static_cast<double>(minimumIntegerDigits_));
+  if (fractionDigits_) {
+    options.emplace(
+        u"minimumFractionDigits", static_cast<double>(fractionDigits_->first));
+    options.emplace(
+        u"maximumFractionDigits", static_cast<double>(fractionDigits_->second));
+  }
+  if (significantDigits_) {
+    options.emplace(
+        u"minimumSignificantDigits",
+        static_cast<double>(significantDigits_->first));
+    options.emplace(
+        u"maximumSignificantDigits",
+        static_cast<double>(significantDigits_->second));
+  }
+  options.emplace(u"useGrouping", Option(useGrouping_ != u"false"));
+  options.emplace(u"notation", notation_);
+  if (compactDisplay_) {
+    options.emplace(u"compactDisplay", *compactDisplay_);
+  }
+  options.emplace(u"signDisplay", signDisplay_);
+  options.emplace(u"roundingMode", roundingMode_);
+  options.emplace(u"trailingZeroDisplay", trailingZeroDisplay_);
+  return options;
+}
