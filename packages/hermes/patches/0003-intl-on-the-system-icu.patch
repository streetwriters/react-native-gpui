+  UErrorCode status = U_ZERO_ERROR;
+  UFieldPositionIterator *positions = ufieldpositer_open(&status);
+  std::u16string text;
+  int32_t length = udat_formatForFields(
+      dateTimeFormatter_, UDate(jsTimeValue), nullptr, 0, positions, &status);
+  if (status == U_BUFFER_OVERFLOW_ERROR) {
+    status = U_ZERO_ERROR;
+    text.resize(length);
+    // The first call used the iterator up; ask again for the fields.
+    ufieldpositer_close(positions);
+    positions = ufieldpositer_open(&status);
+    udat_formatForFields(
+        dateTimeFormatter_,
+        UDate(jsTimeValue),
+        reinterpret_cast<UChar *>(&text[0]),
+        length,
+        positions,
+        &status);
+  }
