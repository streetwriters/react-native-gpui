+
+#ifndef HERMES_PLATFORMINTL_IMPLICU_NUMBERFORMAT_H
+#define HERMES_PLATFORMINTL_IMPLICU_NUMBERFORMAT_H
+
+#include "hermes/Platform/Intl/PlatformIntl.h"
+#include "hermes/Platform/Unicode/icu.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace hermes {
+namespace platform_intl {
+namespace impl_icu {
+
+/// https://402.ecma-international.org/8.0/#numberformat-objects on ICU's
+/// number skeletons (unumf_*). Every option becomes a part of one skeleton
+/// string, which ICU turns into the formatter.
+class NumberFormat : public platform_intl::NumberFormat {
+ public:
+  NumberFormat() = default;
+  ~NumberFormat() override;
+
+  static vm::CallResult<std::vector<std::u16string>> supportedLocalesOf(
+      vm::Runtime &runtime,
+      const std::vector<std::u16string> &locales,
+      const Options &options) noexcept;
+
+  /// https://402.ecma-international.org/8.0/#sec-initializenumberformat
+  vm::ExecutionStatus initialize(
+      vm::Runtime &runtime,
+      const std::vector<std::u16string> &locales,
+      const Options &options) noexcept;
+
+  Options resolvedOptions() noexcept;
+  std::u16string format(double number) noexcept;
+  std::vector<Part> formatToParts(double number) noexcept;
+
+ private:
+  vm::ExecutionStatus setUnitOptions(
+      vm::Runtime &runtime,
+      const Options &options) noexcept;
+  vm::ExecutionStatus setDigitOptions(
+      vm::Runtime &runtime,
+      const Options &options,
+      int mnfdDefault,
+      int mxfdDefault) noexcept;
+
+  /// The ICU number skeleton that stands for the resolved options.
+  std::u16string skeleton(bool legacyUnits) const;
+
+  /// Formats \p number into \p result and returns its text.
+  std::u16string formatInto(double number, UFormattedNumber *result) noexcept;
+
+  std::u16string locale_;
+  std::string locale8_;
+  std::optional<std::u16string> numberingSystem_;
+  std::u16string style_;
+  std::optional<std::u16string> currency_;
+  std::optional<std::u16string> currencyDisplay_;
+  std::optional<std::u16string> currencySign_;
+  std::optional<std::u16string> unit_;
+  std::optional<std::u16string> unitDisplay_;
+  int minimumIntegerDigits_ = 1;
+  std::optional<std::pair<int, int>> fractionDigits_;
+  std::optional<std::pair<int, int>> significantDigits_;
+  /// "fractionDigits", "significantDigits" or "compactRounding".
+  std::u16string roundingType_;
+  /// "auto" or "stripIfInteger".
+  std::u16string trailingZeroDisplay_ = u"auto";
+  std::u16string roundingMode_ = u"halfExpand";
+  /// "always", "auto", "min2" or "false".
+  std::u16string useGrouping_;
+  std::u16string notation_;
+  std::optional<std::u16string> compactDisplay_;
+  std::u16string signDisplay_;
+
+  UNumberFormatter *formatter_ = nullptr;
+};
+
+} // namespace impl_icu
+} // namespace platform_intl
+} // namespace hermes
+
+#endif // HERMES_PLATFORMINTL_IMPLICU_NUMBERFORMAT_H
