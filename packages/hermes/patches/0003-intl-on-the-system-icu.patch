+/// The ECMA-402 part type of an ICU number field, or nullptr when the field
+/// stands for something the spec has no part for.
+const char16_t *partType(int32_t field, bool negative) {
+  switch (field) {
+    case UNUM_INTEGER_FIELD:
+      return u"integer";
+    case UNUM_FRACTION_FIELD:
+      return u"fraction";
+    case UNUM_DECIMAL_SEPARATOR_FIELD:
+      return u"decimal";
+    case UNUM_EXPONENT_SYMBOL_FIELD:
+      return u"exponentSeparator";
+    case UNUM_EXPONENT_SIGN_FIELD:
+      return u"exponentMinusSign";
+    case UNUM_EXPONENT_FIELD:
+      return u"exponentInteger";
+    case UNUM_GROUPING_SEPARATOR_FIELD:
+      return u"group";
+    case UNUM_CURRENCY_FIELD:
+      return u"currency";
+    case UNUM_PERCENT_FIELD:
+      return u"percentSign";
+    case UNUM_SIGN_FIELD:
+      return negative ? u"minusSign" : u"plusSign";
+    case UNUM_MEASURE_UNIT_FIELD:
+      return u"unit";
+    case UNUM_COMPACT_FIELD:
+      return u"compact";
+    default:
+      return nullptr;
+  }
+}
+
+/// A number as text without ICU: the shortest form that reads back the same.
+std::u16string plainNumber(double number) {
+  if (std::isnan(number))
+    return u"NaN";
+  if (std::isinf(number))
+    return number < 0 ? u"-\u221e" : u"\u221e";
+  char buffer[40];
+  for (int digits = 1; digits <= 17; ++digits) {
+    std::snprintf(buffer, sizeof(buffer), "%.*g", digits, number);
+    if (std::strtod(buffer, nullptr) == number) {
+      break;
+    }
+  }
+  std::string text(buffer);
+  return std::u16string(text.begin(), text.end());
+}
