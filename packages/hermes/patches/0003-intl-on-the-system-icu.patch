+std::vector<Part> DateTimeFormatICU::formatToParts(
+    double jsTimeValue) noexcept {
+  std::vector<Part> parts;
+  auto literalOnly = [&](const std::u16string &text) {
+    if (!text.empty()) {
+      Part part;
+      part[u"type"] = u"literal";
+      part[u"value"] = text;
+      parts.push_back(std::move(part));
+    }
+    return parts;
+  };
+  if (!dateTimeFormatter_) {
+    return literalOnly(isoTime(jsTimeValue));
+  }
