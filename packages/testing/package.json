{
  "name": "@react-native-gpui/testing",
  "version": "0.87.0-alpha.1",
  "description": "Test presets and desktop test-driver client for React Native GPUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetwriters/react-native-gpui.git",
    "directory": "packages/testing"
  },
  "homepage": "https://streetwriters.github.io/react-native-gpui/",
  "bugs": {
    "url": "https://github.com/streetwriters/react-native-gpui/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest-preset": {
      "types": "./vitest-preset.d.cts",
      "default": "./vitest-preset.cjs"
    },
    "./vitest-e2e": {
      "types": "./dist/vitest-e2e.d.mts",
      "default": "./dist/vitest-e2e.mjs"
    },
    "./vitest-preset-e2e": {
      "types": "./vitest-preset-e2e.d.cts",
      "default": "./vitest-preset-e2e.cjs"
    }
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-native": "0.87.x",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "typescript": "6.0.3",
    "@types/node": "^22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "*.js",
    "*.cjs",
    "*.d.cts",
    "vitest",
    "CHANGELOG.md",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/*.test.ts",
    "!**/*.test.cjs"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
