{
  "name": "rn-gpui-tester",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-node-addon.mjs",
    "start": "react-native start --port 8082 --config desktop/metro.config.js",
    "predesktop": "node scripts/build-node-addon.mjs",
    "desktop": "node scripts/run-desktop.mts",
    "autolink": "react-native-gpui autolink",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:rust": "node scripts/run-rust-tests.mjs"
  },
  "dependencies": {
    "@node-rs/crc32": "^1.10.8",
    "@react-native-gpui/core": "file:../core",
    "@react-native-gpui/cpp-module-fixture": "file:./gpui-cpp-native-module",
    "@react-native-gpui/fixture-component-module": "file:./fixture-component-module",
    "@react-native-gpui/hermes": "file:../hermes",
    "@react-native-gpui/host-components-fixture": "file:./host-components-module",
    "@react-native-gpui/native-module-fixture": "file:./gpui-native-module",
    "@react-native-gpui/node-addon-fixture": "file:./node-addon-fixture",
    "@react-native/assets-registry": "^0.87.1",
    "farmhash": "^3.3.1",
    "microtime": "^3.1.1",
    "react": "19.2.3",
    "react-freeze": "^1.0.4",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native-gpui/cli": "file:../cli",
    "@react-native-gpui/testing": "file:../testing",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "description": "Interactive test screens and native e2e fixtures for React Native GPUI."
}
